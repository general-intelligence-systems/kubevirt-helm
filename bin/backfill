#!/usr/bin/env bash
set -euo pipefail

FROM="${1:-}"
[[ -n "$FROM" && "$FROM" != v* ]] && FROM="v${FROM}"

RELEASES_FILE="data/releases.yaml"

if [[ ! -f "$RELEASES_FILE" ]]; then
  echo "Error: ${RELEASES_FILE} not found. Run bin/fetch-releases first." >&2
  exit 1
fi

VERSIONS=$(yq -r '.[].tag' "$RELEASES_FILE" | tac)

started=true
[[ -n "$FROM" ]] && started=false
failed=()

for version in $VERSIONS; do
  if [[ "$started" == false ]]; then
    if [[ "$version" == "$FROM" ]]; then
      started=true
    else
      continue
    fi
  fi

  if git tag -l "$version" | grep -q .; then
    echo "skip: ${version} (already tagged)"
    continue
  fi

  echo "building: ${version}"
  if ! bin/build-charts "$version"; then
    echo "FAILED: ${version} (see error above)" >&2
    failed+=("${version}")
  fi
done

if [[ ${#failed[@]} -gt 0 ]]; then
  echo >&2
  echo "${#failed[@]} version(s) failed to build:" >&2
  printf '  %s\n' "${failed[@]}" >&2
  exit 1
fi
