#!/usr/bin/env bash
set -euo pipefail

FROM="${1:-}"
[[ -n "$FROM" && "$FROM" != v* ]] && FROM="v${FROM}"

RELEASES_FILE="data/cdi-releases.yaml"

if [[ ! -f "$RELEASES_FILE" ]]; then
  echo "Error: ${RELEASES_FILE} not found. Run bin/fetch-cdi-releases first." >&2
  exit 1
fi

VERSIONS=$(yq -r '.[].tag' "$RELEASES_FILE" | tac)

started=true
[[ -n "$FROM" ]] && started=false
failed=()

for version in $VERSIONS; do
  if [[ "$started" == false ]]; then
    if [[ "$version" == "$FROM" ]]; then
      started=true
    else
      continue
    fi
  fi

  tag="cdi-${version}"
  if git tag -l "$tag" | grep -q .; then
    echo "skip: ${tag} (already tagged)"
    continue
  fi

  echo "building: ${tag}"
  set +e
  bin/build-cdi-charts "$version"
  rc=$?
  set -e
  case $rc in
    0) ;;
    # exit 3 means upstream published no operator/cr assets for this
    # release -- expected for old versions, not a failure.
    3) echo "skip: ${tag} (no upstream assets)" ;;
    *) echo "FAILED: ${tag} (exit ${rc}, see error above)" >&2
       failed+=("${tag}") ;;
  esac
done

if [[ ${#failed[@]} -gt 0 ]]; then
  echo >&2
  echo "${#failed[@]} version(s) failed to build:" >&2
  printf '  %s\n' "${failed[@]}" >&2
  exit 1
fi
