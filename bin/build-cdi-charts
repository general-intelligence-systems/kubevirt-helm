#!/usr/bin/env bash
set -euo pipefail

VERSION="${1:?Usage: bin/build-cdi-charts <version>}"

# normalize: accept both v1.65.0 and 1.65.0
[[ "$VERSION" != v* ]] && VERSION="v${VERSION}"
CHART_VERSION="${VERSION#v}"

RELEASES_FILE="data/cdi-releases.yaml"

if [[ ! -f "$RELEASES_FILE" ]]; then
  echo "Error: ${RELEASES_FILE} not found. Run bin/fetch-cdi-releases first." >&2
  exit 1
fi

# find the release entry matching this tag
RELEASE=$(yq -o=json ".[] | select(.tag == \"${VERSION}\")" "$RELEASES_FILE")

if [[ -z "$RELEASE" ]]; then
  echo "Error: CDI version ${VERSION} not found in ${RELEASES_FILE}" >&2
  exit 1
fi

# wipe and recreate cdi charts only (preserve kubevirt-* charts)
rm -rf charts/cdi-operator charts/cdi-cr
mkdir -p charts

# iterate over yaml assets only
ASSETS=$(echo "$RELEASE" | jq -c '.assets[] | select(.name == "cdi-operator.yaml" or .name == "cdi-cr.yaml")')

if [[ -z "$ASSETS" ]]; then
  echo "Error: no operator/cr assets found for CDI ${VERSION}" >&2
  exit 3
fi

while IFS= read -r asset; do
  name=$(echo "$asset" | jq -r '.name')
  url=$(echo "$asset" | jq -r '.url')
  chart_name="${name%.yaml}"
  chart_dir="charts/${chart_name}"

  echo "  ${chart_name} @ ${CHART_VERSION}"

  mkdir -p "${chart_dir}/templates"
  curl -sfL -o "${chart_dir}/templates/manifest.yaml" "$url"

  cat > "${chart_dir}/Chart.yaml" <<EOF
apiVersion: v2
name: ${chart_name}
description: CDI ${chart_name} manifests
type: application
version: ${CHART_VERSION}
appVersion: "${CHART_VERSION}"
EOF

done <<< "$ASSETS"

git add -A charts/
git commit -m "chore: sync cdi ${VERSION}"
git tag "cdi-${VERSION}"

echo "Done: committed and tagged cdi-${VERSION}"
