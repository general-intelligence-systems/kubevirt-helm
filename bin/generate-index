#!/usr/bin/env bash
set -euo pipefail

PACKAGES="${1:-.packages}"
INDEX_FILE="index.yaml"

if [[ ! -d "$PACKAGES" ]]; then
  echo "Error: ${PACKAGES} directory not found. Run bin/package-charts first." >&2
  exit 1
fi

# collect entries grouped by chart name
declare -A operator_entries
declare -A cr_entries

cat > "$INDEX_FILE" <<'EOF'
apiVersion: v1
entries:
  kubevirt-operator:
EOF

for tgz in "$PACKAGES"/kubevirt-operator-*.tgz; do
  [[ -f "$tgz" ]] || continue
  filename=$(basename "$tgz")
  version="${filename#kubevirt-operator-}"
  version="${version%.tgz}"
  tag="v${version}"
  digest=$(sha256sum "$tgz" | awk '{print $1}')
  created=$(git log -1 --format=%aI "$tag" 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ")

  cat >> "$INDEX_FILE" <<EOF
    - name: kubevirt-operator
      version: "${version}"
      appVersion: "${version}"
      description: KubeVirt kubevirt-operator manifests
      digest: "${digest}"
      urls:
        - kubevirt-operator-${version}.tgz
      created: "${created}"
EOF
  echo "  kubevirt-operator @ ${version}"
done

cat >> "$INDEX_FILE" <<'EOF'
  kubevirt-cr:
EOF

for tgz in "$PACKAGES"/kubevirt-cr-*.tgz; do
  [[ -f "$tgz" ]] || continue
  filename=$(basename "$tgz")
  version="${filename#kubevirt-cr-}"
  version="${version%.tgz}"
  tag="v${version}"
  digest=$(sha256sum "$tgz" | awk '{print $1}')
  created=$(git log -1 --format=%aI "$tag" 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ")

  cat >> "$INDEX_FILE" <<EOF
    - name: kubevirt-cr
      version: "${version}"
      appVersion: "${version}"
      description: KubeVirt kubevirt-cr manifests
      digest: "${digest}"
      urls:
        - kubevirt-cr-${version}.tgz
      created: "${created}"
EOF
  echo "  kubevirt-cr @ ${version}"
done

echo "generated: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"" >> "$INDEX_FILE"
echo "Done: wrote ${INDEX_FILE}"
