#!/usr/bin/env bash
set -euo pipefail

PACKAGES="${1:-.packages}"
INDEX_FILE="index.yaml"

if [[ ! -d "$PACKAGES" ]]; then
  echo "Error: ${PACKAGES} directory not found. Run bin/package-charts first." >&2
  exit 1
fi

# Chart names are discovered from the packages rather than hardcoded. The
# previous version only ever emitted kubevirt-operator and kubevirt-cr, so
# cdi-* packages were built and then silently dropped from the index.
mapfile -t CHARTS < <(
  for tgz in "$PACKAGES"/*.tgz; do
    [[ -f "$tgz" ]] || continue
    basename "$tgz" | sed -E 's/-[0-9]+\.[0-9]+\.[0-9]+.*\.tgz$//'
  done | sort -u
)

if [[ ${#CHARTS[@]} -eq 0 ]]; then
  echo "Error: no .tgz packages found in ${PACKAGES}" >&2
  exit 1
fi

printf 'apiVersion: v1\nentries:\n' > "$INDEX_FILE"

for chart in "${CHARTS[@]}"; do
  # cdi charts are tagged cdi-vX.Y.Z, kubevirt charts vX.Y.Z
  case "$chart" in
    cdi-*) description="CDI ${chart} manifests"; tag_prefix="cdi-v" ;;
    *)     description="KubeVirt ${chart} manifests"; tag_prefix="v" ;;
  esac

  echo "  ${chart}:" >> "$INDEX_FILE"

  for tgz in "$PACKAGES/${chart}"-*.tgz; do
    [[ -f "$tgz" ]] || continue
    filename=$(basename "$tgz")
    version="${filename#"${chart}"-}"
    version="${version%.tgz}"
    digest=$(sha256sum "$tgz" | awk '{print $1}')
    created=$(git log -1 --format=%aI "${tag_prefix}${version}" 2>/dev/null \
              || date -u +"%Y-%m-%dT%H:%M:%SZ")

    cat >> "$INDEX_FILE" <<EOF
    - name: ${chart}
      version: "${version}"
      appVersion: "${version}"
      description: ${description}
      digest: "${digest}"
      urls:
        - ${filename}
      created: "${created}"
EOF
    echo "  ${chart} @ ${version}"
  done
done

echo "generated: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"" >> "$INDEX_FILE"
echo "Done: wrote ${INDEX_FILE}"
