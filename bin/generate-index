#!/usr/bin/env bash
set -euo pipefail

PACKAGES="${1:-.packages}"
INDEX_FILE="index.yaml"

if [[ ! -d "$PACKAGES" ]]; then
  echo "Error: ${PACKAGES} directory not found. Run bin/package-charts first." >&2
  exit 1
fi

shopt -s nullglob
PKGS=("$PACKAGES"/*.tgz)
if [[ ${#PKGS[@]} -eq 0 ]]; then
  echo "Error: no chart packages in ${PACKAGES}." >&2
  exit 1
fi

# chart name is everything before the trailing -<version>; collect the set
CHARTS=$(for tgz in "${PKGS[@]}"; do
  base=$(basename "$tgz" .tgz)
  echo "${base%-[0-9]*}"
done | sort -u)

cat > "$INDEX_FILE" <<'EOF'
apiVersion: v1
entries:
EOF

for chart in $CHARTS; do
  echo "  ${chart}:" >> "$INDEX_FILE"

  versions=$(for tgz in "$PACKAGES/${chart}"-[0-9]*.tgz; do
    base=$(basename "$tgz" .tgz)
    echo "${base#"${chart}"-}"
  done | sort -V)

  for version in $versions; do
    tgz="${PACKAGES}/${chart}-${version}.tgz"
    digest=$(sha256sum "$tgz" | awk '{print $1}')

    # description and appVersion come from the packaged chart itself
    metadata=$(tar -xzOf "$tgz" "${chart}/Chart.yaml")
    description=$(yq -r '.description' - <<< "$metadata")
    app_version=$(yq -r '.appVersion' - <<< "$metadata")

    # cdi-* charts are tagged cdi-v<version>, kubevirt-* charts v<version>
    case "$chart" in
      cdi-*) tag="cdi-v${version}" ;;
      *)     tag="v${version}" ;;
    esac
    created=$(git log -1 --format=%aI "$tag" 2> /dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ")

    cat >> "$INDEX_FILE" <<EOF
    - name: ${chart}
      version: "${version}"
      appVersion: "${app_version}"
      description: ${description}
      digest: "${digest}"
      urls:
        - ${chart}-${version}.tgz
      created: "${created}"
EOF
    echo "  ${chart} @ ${version}"
  done
done

echo "generated: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"" >> "$INDEX_FILE"
echo "Done: wrote ${INDEX_FILE}"
